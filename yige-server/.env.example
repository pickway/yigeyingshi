SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=debug

# ===== 数据库（MySQL）=====
# 必须带 parseTime=True 与 loc=Local，否则 DATETIME 字段无法映射为 time.Time
# 部署时请把占位符替换为真实凭据，建议用 docker run --env-file .env 注入
#   docker run --env-file .env -v /var/log/yige:/var/log/yige yige-server:latest
DB_DRIVER=mysql
DB_DSN=MYSQL_USER:MYSQL_PASSWORD@tcp(MYSQL_HOST:MYSQL_PORT)/MYSQL_DATABASE?charset=utf8mb4&parseTime=True&loc=Local

# ===== HTTP 访问日志（写本地 JSON 行文件，供 Filebeat 采集到 ES）=====
# 开发期默认 ./logs/access.log；生产部署到服务器时改为 /var/log/yige/yige-server-access.log
ACCESS_LOG_PATH=logs/access.log
ACCESS_LOG_MAX_SIZE_MB=100
ACCESS_LOG_MAX_BACKUPS=5
ACCESS_LOG_MAX_AGE_DAYS=7
ACCESS_LOG_COMPRESS=true

# 生产部署时设置为站点来源，多个来源用英文逗号分隔
# ALLOWED_ORIGINS=https://example.com
