ADMIN_SERVER_HOST=127.0.0.1
ADMIN_SERVER_PORT=8081
ADMIN_GIN_MODE=debug

# ===== 数据库（MySQL）必须与前台 yige-server 使用同一个库，共享内容数据 =====
# 必须带 parseTime=True 与 loc=Local，否则 DATETIME 字段无法映射为 time.Time
# 部署时请把占位符替换为真实凭据，建议用 docker run --env-file .env 注入
#   docker run --env-file .env -v /var/log/yige:/var/log/yige yige-admin-server:latest
ADMIN_DB_DSN=MYSQL_USER:MYSQL_PASSWORD@tcp(MYSQL_HOST:MYSQL_PORT)/MYSQL_DATABASE?charset=utf8mb4&parseTime=True&loc=Local

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_ALLOWED_ORIGIN=http://127.0.0.1:4174

# ===== HTTP 访问日志（写本地 JSON 行文件，供 Filebeat 采集到 ES）=====
# 开发期默认 ./logs/access.log；生产部署到服务器时改为 /var/log/yige/yige-admin-server-access.log
ADMIN_ACCESS_LOG_PATH=logs/access.log
ADMIN_ACCESS_LOG_MAX_SIZE_MB=100
ADMIN_ACCESS_LOG_MAX_BACKUPS=5
ADMIN_ACCESS_LOG_MAX_AGE_DAYS=7
ADMIN_ACCESS_LOG_COMPRESS=true
